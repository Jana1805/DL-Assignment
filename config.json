{
  "project": "Just-In-Time Software Defect Prediction on ApacheJIT",
  "random_seed": 42,

  "environment": {
    "platform": "Google Colab",
    "runtime": "GPU (CUDA 12.8)",
    "torch_version_installed": "2.11.0+cu128",
    "note": "requirements.txt lists torch==2.11.0 without the CUDA build suffix for cross-platform installability; the actual training runs used the +cu128 GPU build shown here."
  },

  "data": {
    "source": "apachejit_total.csv",
    "total_rows": 106674,
    "feature_columns_v1": [
      "la", "ld", "nf", "nd", "ns", "ent",
      "ndev", "age", "nuc", "aexp", "arexp", "asexp"
    ],
    "derived_features_v2": [
      "total_churn", "churn_per_file", "files_per_dir",
      "add_delete_ratio", "exp_ratio"
    ],
    "log_transformed_columns_v2": [
      "la", "ld", "nf", "nd", "ns", "ndev", "age", "nuc",
      "aexp", "arexp", "asexp", "total_churn", "churn_per_file"
    ],
    "label_column": "buggy",
    "split": {
      "method": "chronological",
      "train_years": "2003-2014",
      "val_years": "2015-2016",
      "test_years": "2017-2019",
      "train_rows": 52133,
      "val_rows": 24430,
      "test_rows": 30111
    },
    "scaling": {
      "method": "StandardScaler",
      "fit_on": "train_only"
    },
    "class_weighting": {
      "method": "sklearn.utils.class_weight.compute_class_weight",
      "strategy": "balanced"
    }
  },

  "models": {
    "logistic_regression": {
      "library": "scikit-learn",
      "class_weight": "balanced",
      "max_iter": 1000,
      "random_state": 42,
      "regularization": "L2 (default, C=1.0)",
      "decision_threshold": {
        "method": "F1-maximizing sweep on validation set",
        "range": "0.05 to 0.95, step 0.01"
      }
    },

    "deep_mlp": {
      "library": "PyTorch",
      "architecture": {
        "hidden_dims": [128, 64, 32],
        "activation": "ReLU",
        "normalization": "BatchNorm1d",
        "dropout": 0.5,
        "output_dim": 2
      },
      "training": {
        "loss": "CrossEntropyLoss (class-weighted)",
        "optimizer": "Adam",
        "learning_rate": 0.001,
        "lr_scheduler": "ReduceLROnPlateau (factor=0.5, patience=5)",
        "batch_size": 256,
        "max_epochs": 100,
        "early_stopping_patience": 10,
        "early_stopping_metric": "validation_loss"
      },
      "dropout_selection": {
        "method": "sweep across candidate values, 3 seeds each",
        "candidates": [0.4, 0.5],
        "selection_metric": "mean validation macro-F1",
        "selected_value": 0.5
      },
      "decision_threshold": {
        "method": "F1-maximizing sweep on validation set",
        "range": "0.05 to 0.95, step 0.01"
      },
      "random_seed": 42
    },

    "tabnet": {
      "library": "pytorch-tabnet",
      "architecture": {
        "n_d": 8,
        "n_a": 8,
        "n_steps": 3,
        "gamma": 1.3,
        "lambda_sparse": 0.001,
        "mask_type": "entmax"
      },
      "training": {
        "optimizer": "Adam",
        "learning_rate": 0.02,
        "lr_scheduler": "StepLR (step_size=20, gamma=0.5)",
        "batch_size": 256,
        "virtual_batch_size": 128,
        "max_epochs": 100,
        "early_stopping_patience": 10,
        "early_stopping_metric": "validation_auc",
        "class_weighting": "weights dict passed to fit()"
      },
      "decision_threshold": {
        "method": "F1-maximizing sweep on validation set",
        "range": "0.05 to 0.95, step 0.01"
      },
      "random_seed": 42,
      "note": "ReduceLROnPlateau is incompatible with pytorch-tabnet's internal scheduler.step() call (raises TypeError: missing required argument 'metrics'). StepLR was used instead."
    }
  },

  "evaluation": {
    "metrics": [
      "accuracy", "precision", "recall", "f1",
      "roc_auc", "pr_auc", "confusion_matrix"
    ],
    "test_set_evaluated": "once per model, after all tuning was finalized on validation set"
  }
}
